# OpenSubtitles API Configuration
# Copy this file to .env and fill in your actual values.
# Vite picks up VITE_* vars at build/dev-server time.

# ---------------------------------------------------------------------------
# REST API key (Consumer "Api-Key" header, required for ALL requests)
# Get one from: https://www.opensubtitles.com/en/consumers
# ---------------------------------------------------------------------------
VITE_OPENSUBTITLES_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# REST API base URL (optional — defaults to production .com)
# All endpoint URLs are derived from this base.
#
# Useful overrides:
#   - Local dev (Rails on localhost:3001):
#     VITE_OPENSUBTITLES_BASE_URL=http://localhost:3001/api/v1
#   - Local dev via ngrok (stable subdomain):
#     VITE_OPENSUBTITLES_BASE_URL=https://osdev.ngrok.dev/api/v1
#   - Internal direct (bypasses Kong/CDN):
#     VITE_OPENSUBTITLES_BASE_URL=http://172.20.120.13/api/v1
#   - Staging:
#     VITE_OPENSUBTITLES_BASE_URL=https://staging.opensubtitles.com/api/v1
#   - Production (default — leave commented out):
#     VITE_OPENSUBTITLES_BASE_URL=https://api.opensubtitles.com/api/v1
#
# The /api/v1 suffix is auto-appended if you forget it.
# Trailing slashes are stripped.
# ---------------------------------------------------------------------------
# VITE_OPENSUBTITLES_BASE_URL=http://localhost:3001/api/v1
